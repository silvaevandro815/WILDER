# Credenciais do Supabase (Insira suas chaves do Supabase aqui)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# APIs
OPENROUTER_API_KEY=your-openrouter-api-key
META_ACCESS_TOKEN=your-meta-access-token
APIFY_API_TOKEN=your-apify-api-token

# Configurações de E-mail SMTP (para Alertas de Crise)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_ou_smtp
EMAIL_FROM=seu_email@gmail.com
ALERT_EMAIL_RECIPIENTS=comite1@email.com,comite2@email.com
